# =============================================================================
# Oasis Seguros - Variables de entorno
# Copiar a `.env` (raíz) y/o `apps/api/.env` según el entorno.
# NUNCA versionar archivos .env reales.
# =============================================================================

# --- Aplicación -------------------------------------------------------------
# development | test | production
NODE_ENV=development
# Puerto HTTP del API
PORT=3000

# --- Base de datos (PostgreSQL) ---------------------------------------------
# Usado por Prisma (API, worker y tarea migrate)
DATABASE_URL=postgresql://oasis:oasis@localhost:5432/oasis?schema=public
# Credenciales usadas por la imagen de postgres en Docker
POSTGRES_USER=oasis
POSTGRES_PASSWORD=cambia-esto
POSTGRES_DB=oasis

# --- Redis / BullMQ ---------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# Opcional: contraseña de Redis (vacío en desarrollo)
REDIS_PASSWORD=

# --- Autenticación JWT ------------------------------------------------------
# Generar con: openssl rand -hex 32
JWT_ACCESS_SECRET=genera-un-secreto-de-32-bytes-hex
JWT_REFRESH_SECRET=genera-otro-secreto-distinto-de-32-bytes-hex
# Duración de tokens (el access es corto; el refresh en cookie httpOnly)
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Blockchain -------------------------------------------------------------
# 31337 = Hardhat local | 80002 = Polygon Amoy (testnet) | 137 = Polygon PoS
CHAIN_ID=31337
# RPC principal (Amoy: https://rpc-amoy.polygon.technology)
RPC_URL=http://127.0.0.1:8545
# RPC de respaldo opcional, usado con el transporte `fallback` de viem
RPC_URL_FALLBACK=
# Dirección del contrato RegistroRecibos desplegado
CONTRACT_ADDRESS=
# Clave privada de la cuenta OPERADORA (REGISTRADOR_ROLE).
# SOLO la lee el worker. El API nunca debe cargarla ni exponerla.
OPERATOR_PRIVATE_KEY=
# Tope de gas para `registrar` (protege ante picos de fee)
MAX_FEE_PER_GAS_GWEI=50
# URL base del explorador para enlaces públicos
# Amoy: https://amoy.polygonscan.com | Local: http://localhost:8545
EXPLORER_BASE_URL=https://amoy.polygonscan.com

# --- Dominio / TLS ----------------------------------------------------------
# Dominio servido por Caddy (TLS automático). En local: localhost
DOMAIN=localhost

# --- Frontend (Vite) --------------------------------------------------------
# Solo se usa en `pnpm dev` del SPA (en producción Caddy sirve mismo origen)
VITE_API_BASE_URL=http://localhost:3000/api/v1
