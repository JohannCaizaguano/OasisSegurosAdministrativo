# =============================================================================
# Oasis Seguros - Variables de entorno
# Copiar a `.env` (raíz) y/o `apps/api/.env` según el entorno.
# NUNCA versionar archivos .env reales.
# =============================================================================

# --- Aplicación -------------------------------------------------------------
# development | test | production
NODE_ENV=development
# Puerto HTTP del API
PORT=3000
# Nivel de log (trace | debug | info | warn | error | fatal)
LOG_LEVEL=info
# Salida legible de pino SOLO para desarrollo: `pnpm dev:pretty`
LOG_PRETTY=false
# Orígenes del SPA permitidos en desarrollo (separados por comas).
# En producción Caddy sirve SPA y API en el mismo origen (ADR-009) y no aplica.
CORS_ORIGIN=http://localhost:5173

# --- Base de datos (PostgreSQL) ---------------------------------------------
# Usado por Prisma (API, worker y tarea migrate).
# En Docker con compose.prod.yaml el host es `postgres` (nombre de servicio):
#   DATABASE_URL=postgresql://oasis:<password>@postgres:5432/oasis?schema=public
# OJO: POSTGRES_PASSWORD debe coincidir con la contraseña de esta URL, o
# `migrate` fallará con "password authentication failed".
DATABASE_URL=postgresql://oasis:oasis@localhost:5432/oasis?schema=public
# Credenciales usadas por la imagen de postgres en Docker
POSTGRES_USER=oasis
POSTGRES_PASSWORD=oasis
POSTGRES_DB=oasis

# --- Seed (solo `pnpm --filter @oasis/api seed`) ----------------------------
# Correo del ADMIN sembrado (opcional; por defecto admin@oasis.com).
SEED_ADMIN_EMAIL=
# Opcionales: si se omiten, el seed usa Admin.Oasis1, Operador.Oasis1 y
# Cliente.Oasis1. En producción el seed se NIEGA a usar los valores por
# defecto: defina las tres contraseñas con valores propios.
SEED_ADMIN_PASSWORD=
SEED_OPERADOR_PASSWORD=
SEED_CLIENTE_PASSWORD=

# --- Redis / BullMQ ---------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# Opcional: contraseña de Redis (vacío en desarrollo)
REDIS_PASSWORD=

# --- Autenticación JWT ------------------------------------------------------
# Generar con: openssl rand -hex 32
JWT_ACCESS_SECRET=genera-un-secreto-de-32-bytes-hex
JWT_REFRESH_SECRET=genera-otro-secreto-distinto-de-32-bytes-hex
# Duración de tokens (el access es corto; el refresh en cookie httpOnly)
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Blockchain -------------------------------------------------------------
# 31337 = Hardhat local | 80002 = Polygon Amoy (testnet) | 137 = Polygon PoS
CHAIN_ID=31337
# RPC principal (Amoy: https://polygon-amoy-bor-rpc.publicnode.com o una URL propia)
RPC_URL=http://127.0.0.1:8545
# RPC de respaldo opcional, usado con el transporte `fallback` de viem
RPC_URL_FALLBACK=
# Dirección del contrato RegistroRecibos desplegado
CONTRACT_ADDRESS=
# Tope de gas para `registrar` (protege ante picos de fee)
MAX_FEE_PER_GAS_GWEI=50
# La clave privada de la cuenta operadora NO va aquí: vive en `.env.worker`
# (plantilla en `.env.worker.example`), que solo inyecta el contenedor `worker`.
# Dirección pública de la cuenta operadora (REGISTRADOR_ROLE). La usa
# `packages/contracts/scripts/grant-registrador.ts`; no es un secreto.
OPERATOR_ADDRESS=
# URL base del explorador para enlaces públicos
# Amoy: https://amoy.polygonscan.com | Local: http://localhost:8545
EXPLORER_BASE_URL=https://amoy.polygonscan.com

# --- Rate limiter (peticiones por minuto y por IP) --------------------------
# Los valores por defecto son de SEGURIDAD: 5/min en login protege contra
# fuerza bruta. Una prueba de carga con ellos midió el limitador en lugar del
# API, por lo que se hacen configurables. Ver docs/despliegue.md, día de
# evaluación. Recordatorio: restaurarlos al terminar.
THROTTLE_GLOBAL_LIMIT=100
THROTTLE_LOGIN_LIMIT=5
THROTTLE_REFRESH_LIMIT=20

# --- Worker -----------------------------------------------------------------
# Puerto del exporter de métricas del anclaje (red interna; Prometheus lo
# scrapea en worker:<puerto>/metrics). Caddy no lo expone.
WORKER_METRICS_PORT=9101

# --- Dominio / TLS ----------------------------------------------------------
# Dominio servido por Caddy (TLS automático). En local: localhost
DOMAIN=localhost

# --- Imágenes (compose.prod.yaml) -------------------------------------------
# Registros y etiqueta; por defecto usan ghcr.io/oasis-seguros/*:latest
OASIS_API_IMAGE=ghcr.io/oasis-seguros/oasis-api
OASIS_MIGRATOR_IMAGE=ghcr.io/oasis-seguros/oasis-api-migrator
OASIS_WEB_IMAGE=ghcr.io/oasis-seguros/oasis-web
OASIS_TAG=latest

# --- Monitoreo (compose.monitoring.yaml, solo el día de evaluación) ---------
# Grafana NO publica puertos: se accede por túnel SSH
#   ssh -L 3001:localhost:3001 deploy@<VPS>
GRAFANA_ADMIN_PASSWORD=cambia-esta-contrasena

# --- Frontend (Vite) --------------------------------------------------------
# Solo se usa en `pnpm dev` del SPA (en producción Caddy sirve mismo origen)
VITE_API_BASE_URL=http://localhost:3000/api/v1
