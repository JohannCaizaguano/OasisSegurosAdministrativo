// Prisma 7: el generator `prisma-client` emite TypeScript puro dentro de src/.
// Se compila junto al API (CommonJS), por eso moduleFormat = "cjs".
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Modelo de datos completo de ARQUITECTURA §9 (transcripción 9.0).
// Decisiones: ADR-010 (migración inicial con todo el modelo) y ADR-011.
// Regla RN-09: sin borrado en cascada; los registros con historial se
// desactivan o cambian de estado, por eso no hay `onDelete` en las relaciones.
// ---------------------------------------------------------------------------

enum Rol {
  ADMIN
  OPERADOR
  CLIENTE
}

enum TipoIdentificacion {
  CEDULA
  RUC
  PASAPORTE
}

enum EstadoPoliza {
  VIGENTE
  VENCIDA
  CANCELADA
}

enum EstadoCuota {
  PENDIENTE
  PARCIAL
  PAGADA
  VENCIDA
}

enum EstadoPago {
  REGISTRADO
  VALIDADO
  RECHAZADO
}

enum EstadoRecibo {
  PENDIENTE_ANCLAJE
  ENVIADO
  ANCLADO
  FALLIDO
  ANULADO
}

model Usuario {
  id                String    @id @default(uuid()) @db.Uuid
  email             String    @unique
  passwordHash      String
  rol               Rol
  activo            Boolean   @default(true)
  clienteId         String?   @unique @db.Uuid
  // Aceptación de la política de tratamiento de datos (HU-33).
  politicaAceptadaEn DateTime?
  politicaVersion    String?
  cliente           Cliente?  @relation(fields: [clienteId], references: [id])
  pagosRegistrados  Pago[]    @relation("PagoRegistradoPor")
  pagosValidados    Pago[]    @relation("PagoValidadoPor")
  tokensRecuperacion TokenRecuperacion[]
  bitacora          BitacoraAuditoria[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([rol])
}

model TokenRecuperacion {
  id        String    @id @default(uuid()) @db.Uuid
  usuarioId String    @db.Uuid
  tokenHash String
  expiraEn  DateTime
  usadoEn   DateTime?
  creadoEn  DateTime  @default(now())
  usuario   Usuario   @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@index([tokenHash])
}

/// Bitácora de auditoría (HU-45): solo inserciones; la aplicación no la
/// modifica ni la elimina (RN-17). Un trigger de PostgreSQL rechaza UPDATE,
/// DELETE y TRUNCATE (migración `bitacora_solo_insercion`).
model BitacoraAuditoria {
  id        String   @id @default(uuid()) @db.Uuid
  usuarioId String   @db.Uuid
  accion    String
  entidad   String
  entidadId String?
  ip        String?
  detalle   Json?
  creadoEn  DateTime @default(now())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@index([accion])
  @@index([creadoEn])
}

model Cliente {
  id                 String             @id @default(uuid()) @db.Uuid
  tipoIdentificacion TipoIdentificacion
  identificacion     String             @unique
  nombres            String?
  apellidos          String?
  razonSocial        String?
  email              String
  telefono           String?
  activo             Boolean            @default(true)
  usuario            Usuario?
  polizas            Poliza[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([email])
  @@index([tipoIdentificacion])
}

model Aseguradora {
  id        String   @id @default(uuid()) @db.Uuid
  nombre    String
  ruc       String   @unique
  polizas   Poliza[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Catálogo de ramos de seguro (p. ej. Vida, Salud, Vehículos, Incendio,
/// Fianzas). `codigo` es el identificador estable que usa el API/SPA; el
/// nombre es el valor visible. `activo` permite desactivarlo sin eliminarlo.
model Ramo {
  id        String   @id @default(uuid()) @db.Uuid
  codigo    String   @unique
  nombre    String   @unique
  activo    Boolean  @default(true)
  polizas   Poliza[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Catálogo de métodos de pago (Transferencia, Depósito, Efectivo, Tarjeta).
model MetodoPago {
  id        String   @id @default(uuid()) @db.Uuid
  codigo    String   @unique
  nombre    String   @unique
  activo    Boolean  @default(true)
  pagos     Pago[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Poliza {
  id            String       @id @default(uuid()) @db.Uuid
  numero        String       @unique
  clienteId     String       @db.Uuid
  aseguradoraId String       @db.Uuid
  ramoId        String       @db.Uuid
  primaTotal    Decimal      @db.Decimal(12, 2)
  fechaInicio   DateTime     @db.Date
  fechaFin      DateTime     @db.Date
  estado        EstadoPoliza @default(VIGENTE)
  cliente       Cliente      @relation(fields: [clienteId], references: [id])
  aseguradora   Aseguradora  @relation(fields: [aseguradoraId], references: [id])
  ramo          Ramo         @relation(fields: [ramoId], references: [id])
  cuotas        Cuota[]
  pagos         Pago[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([clienteId])
  @@index([aseguradoraId])
  @@index([ramoId])
  @@index([estado])
  @@index([fechaFin])
}

model Cuota {
  id               String         @id @default(uuid()) @db.Uuid
  polizaId         String         @db.Uuid
  numero           Int
  valor            Decimal        @db.Decimal(12, 2)
  valorPagado      Decimal        @default(0) @db.Decimal(12, 2)
  fechaVencimiento DateTime       @db.Date
  estado           EstadoCuota    @default(PENDIENTE)
  poliza           Poliza         @relation(fields: [polizaId], references: [id])
  aplicaciones     AplicacionPago[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([polizaId, numero])
  @@index([polizaId])
  @@index([estado, fechaVencimiento])
}

model Pago {
  id              String     @id @default(uuid()) @db.Uuid
  polizaId        String     @db.Uuid
  monto           Decimal    @db.Decimal(12, 2)
  fechaPago       DateTime   @db.Date
  metodoPagoId    String     @db.Uuid
  referencia      String?
  comprobanteRuta String?
  estado          EstadoPago @default(REGISTRADO)
  registradoPorId String?    @db.Uuid
  validadoPorId   String?    @db.Uuid
  validadoEn      DateTime?
  // Motivo obligatorio del rechazo (HU-19).
  motivoRechazo   String?
  // Nota de auditoría del operador al validar (ampliación del proyecto; es
  // interna: nunca entra al payload canónico del recibo ni a la blockchain).
  nota            String?
  poliza          Poliza      @relation(fields: [polizaId], references: [id])
  metodoPago      MetodoPago  @relation(fields: [metodoPagoId], references: [id])
  registradoPor   Usuario?    @relation("PagoRegistradoPor", fields: [registradoPorId], references: [id])
  validadoPor     Usuario?    @relation("PagoValidadoPor", fields: [validadoPorId], references: [id])
  aplicaciones    AplicacionPago[]
  recibo          Recibo?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([polizaId])
  @@index([metodoPagoId])
  @@index([estado])
  @@index([registradoPorId])
  @@index([validadoPorId])
  @@index([fechaPago])
}

/// Aplicación de un pago a una cuota (HU-36): qué parte de cada pago cubre
/// cada cuota.
model AplicacionPago {
  id       String   @id @default(uuid()) @db.Uuid
  pagoId   String   @db.Uuid
  cuotaId  String   @db.Uuid
  monto    Decimal  @db.Decimal(12, 2)
  creadoEn DateTime @default(now())
  pago     Pago     @relation(fields: [pagoId], references: [id])
  cuota    Cuota    @relation(fields: [cuotaId], references: [id])

  @@index([pagoId])
  @@index([cuotaId])
}

model Recibo {
  id                String       @id @default(uuid()) @db.Uuid
  codigo            String       @unique
  pagoId            String       @unique @db.Uuid
  idOnchain         String
  hashRecibo        String
  sal               String
  payloadCanonico   String
  estado            EstadoRecibo @default(PENDIENTE_ANCLAJE)
  txHash            String?
  blockNumber       BigInt?
  gasUsed           BigInt?
  // Ampliaciones del proyecto para operación y auditoría del anclaje.
  effectiveGasPrice BigInt?
  chainId           Int
  contractAddress   String
  intentos          Int          @default(0)
  ultimoError       String?
  creadoEn          DateTime     @default(now())
  enviadoEn         DateTime?
  ancladoEn         DateTime?
  updatedAt         DateTime     @updatedAt
  pago              Pago         @relation(fields: [pagoId], references: [id])

  @@index([estado])
  @@index([creadoEn])
}
