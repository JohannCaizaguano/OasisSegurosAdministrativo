      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:0 18px;border:0;border-radius:8px;background:linear-gradient(135deg,#f6d592 0%,#e2ad5b 55%,#c98f3e 100%);color:#1a140c;font:600 15px Figtree,system-ui,sans-serif;box-shadow:inset 0 1px 0 rgba(255,255,255,.4),0 2px 6px rgba(26,20,12,.16);cursor:pointer;transition:transform .15s cubic-bezier(.32,.72,0,1),filter .2s}.ds-btn-primary:hover{filter:brightness(1.06)}.ds-btn-primary:active{transform:scale(.97)}.ds-btn-primary:focus-visible{outline:3px solid #1a1714;outline-offset:2px}"
