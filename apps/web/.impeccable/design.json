      "description": "Rol del usuario; no es un estado.",
      "html": "<span class=\"ds-tag ds-tag-adm\">Administrador</span> <span class=\"ds-tag\">Operador</span>",
      "css": ".ds-tag{display:inline-flex;align-items:center;height:24px;padding:0 9px;border-radius:6px;font:700 12px Figtree,system-ui,sans-serif;letter-spacing:.04em;background:#efebe4;color:#1a1714}.ds-tag-adm{background:#14110d;color:#f0c878}"
