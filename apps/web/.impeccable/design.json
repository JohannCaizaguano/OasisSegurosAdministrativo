    {
      "name": "Interruptor de catálogo",
      "kind": "custom",
      "refersTo": "switch",
      "description": "Activa o desactiva un elemento del catálogo.",
      "html": "<label class=\"ds-row\"><span>Débito bancario</span><button class=\"ds-switch\" role=\"switch\" aria-checked=\"true\" aria-label=\"Débito bancario\"></button></label>",
      "css": ".ds-row{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:52px;font:600 15px Figtree,system-ui,sans-serif;color:#1a1714}.ds-switch{width:46px;height:28px;border-radius:14px;border:0;background:#8c8478;position:relative;padding:0;cursor:pointer}.ds-switch::after{content:\"\";position:absolute;top:3px;left:3px;width:22px;height:22px;border-radius:50%;background:#fff;box-shadow:0 1px 3px rgba(0,0,0,.25);transition:transform .2s cubic-bezier(.32,.72,0,1)}.ds-switch[aria-checked=true]{background:#2f6b3a}.ds-switch[aria-checked=true]::after{transform:translateX(18px)}.ds-switch:focus-visible{outline:3px solid #1a1714;outline-offset:2px}"
    },
    {
      "name": "Código de un solo uso",
      "kind": "input",
      "refersTo": "input",
      "description": "Segundo factor del administrador.",
      "html": "<input class=\"ds-otp\" inputmode=\"numeric\" autocomplete=\"one-time-code\" maxlength=\"6\" placeholder=\"000000\" aria-label=\"Código de verificación\">",
      "css": ".ds-otp{width:260px;height:60px;border:1px solid #8c8478;border-radius:8px;background:#fff;font:600 26px/1 Outfit,system-ui,sans-serif;letter-spacing:.5em;text-align:center;padding-left:.5em;color:#1a1714}.ds-otp:focus{outline:0;border:2px solid #1a1714;box-shadow:0 0 0 4px rgba(226,173,91,.38)}"
    },
    {
      "name": "Tarjeta",
