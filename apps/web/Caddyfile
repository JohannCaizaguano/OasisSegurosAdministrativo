# Caddy: SPA estática + reverse proxy del API en el mismo origen (sin CORS).
{$DOMAIN:localhost} {
	encode zstd gzip

	# El API escucha en la red interna; Caddy lo publica bajo /api/*.
	handle /api/* {
		reverse_proxy api:3000
	}

	# /metrics jamás se expone públicamente.
	handle /metrics* {
		respond "No encontrado" 404
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; font-src 'self' data:; object-src 'none'; frame-ancestors 'self'"
		-Server
	}

	log {
		output stdout
		format json
	}
}
