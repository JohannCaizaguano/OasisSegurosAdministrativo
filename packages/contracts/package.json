{
  "name": "@oasis/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Contrato RegistroRecibos (Hardhat 3 + Ignition + viem) y pruebas",
  "type": "module",
  "scripts": {
    "build": "hardhat compile",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:solidity": "hardhat test solidity",
    "test:nodejs": "hardhat test nodejs",
    "coverage": "hardhat test --coverage",
    "gas-stats": "hardhat test --gas-stats",
    "lint": "solhint \"contracts/**/*.sol\"",
    "typecheck": "hardhat compile && tsc --noEmit",
    "export-abi": "hardhat run scripts/export-abi.ts",
    "deploy:local": "hardhat compile --build-profile production && hardhat ignition deploy ignition/modules/RegistroRecibos.ts --network localhost",
    "deploy:amoy": "hardhat compile --build-profile production && hardhat ignition deploy ignition/modules/RegistroRecibos.ts --network amoy --parameters ignition/parameters/amoy.json",
    "grant-registrador": "hardhat run scripts/grant-registrador.ts",
    "reporte": "hardhat test --coverage --gas-stats && node scripts/reporte.ts",
    "build:production": "hardhat compile --build-profile production"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition": "^3.1.8",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@openzeppelin/contracts": "^5.6.1",
    "@types/node": "^24.0.0",
    "forge-std": "github:foundry-rs/forge-std#v1.16.2",
    "hardhat": "^3.18.0",
    "solhint": "^6.0.0",
    "typescript": "6.0.3",
    "viem": "^2.56.9"
  }
}
